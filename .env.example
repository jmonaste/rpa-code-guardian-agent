# OpenAI-compatible endpoint serving the local models (must end in /v1)
OPENAI_BASE_URL=http://localhost:8000/v1
# Any non-empty string if the endpoint ignores it
OPENAI_API_KEY=not-needed

# Model used for the per-workflow map phase (many small calls)
GUARDIAN_WORKER_MODEL=gemma
# Model used for planning, narrative and compliance (fewer, harder calls)
GUARDIAN_LEAD_MODEL=gpt-oss

# Sampling temperature for all calls (keep at 0 for reproducible documents)
GUARDIAN_TEMPERATURE=0

# Verify the endpoint's TLS certificate. Set to false ONLY for a trusted
# local/corporate endpoint that uses a self-signed certificate.
GUARDIAN_VERIFY_SSL=true
# HTTP timeout in seconds per LLM call (local models can be slow to respond)
GUARDIAN_REQUEST_TIMEOUT=120

# Max completion tokens per call. Reasoning models (e.g. gpt-oss) spend tokens
# thinking before answering; too low a budget truncates the JSON and validation
# fails ("EOF while parsing"). Raise this if summaries still come back truncated.
GUARDIAN_MAX_TOKENS=8192

# Retries per LLM call on transient endpoint errors (429 rate limit,
# 502/503/504 gateway errors, timeouts). Local endpoints under parallel load
# hit these routinely; a short backoff usually recovers the call.
GUARDIAN_LLM_RETRIES=3
# Initial backoff delay in seconds; doubles per retry (capped at 60s)
GUARDIAN_LLM_RETRY_BASE_DELAY=2

# Max parallel LLM calls during the map phase (match your endpoint capacity)
GUARDIAN_MAX_CONCURRENCY=4

# Tool-loop iteration cap for the gap-fill and compliance evidence agents
GUARDIAN_AGENT_MAX_ITERATIONS=8

# Character budget for a single workflow IR handed to the worker model
GUARDIAN_IR_MAX_CHARS=12000
