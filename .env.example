# OpenAI-compatible endpoint serving the local models (must end in /v1)
OPENAI_BASE_URL=http://localhost:8000/v1
# Any non-empty string if the endpoint ignores it
OPENAI_API_KEY=not-needed

# Model used for the per-workflow map phase (many small calls)
GUARDIAN_WORKER_MODEL=gemma
# Model used for planning, narrative and compliance (fewer, harder calls)
GUARDIAN_LEAD_MODEL=gpt-oss

# Sampling temperature for all calls (keep at 0 for reproducible documents)
GUARDIAN_TEMPERATURE=0

# Max parallel LLM calls during the map phase (match your endpoint capacity)
GUARDIAN_MAX_CONCURRENCY=4

# Tool-loop iteration cap for the gap-fill and compliance evidence agents
GUARDIAN_AGENT_MAX_ITERATIONS=8

# Character budget for a single workflow IR handed to the worker model
GUARDIAN_IR_MAX_CHARS=12000
